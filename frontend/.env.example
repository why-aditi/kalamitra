# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Analytics Configuration (Optional)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# AI
# There is deliberately no Gemini key here. Anything prefixed NEXT_PUBLIC_ is
# inlined into the JavaScript bundle at build time, so NEXT_PUBLIC_GEMINI_API_KEY
# shipped in plaintext to every visitor on every route. The browser now calls
# POST /api/chat and POST /api/search/translate; the key lives only in the
# backend's GEMINI_API_KEY. Do not reintroduce it here.
#
# The Cloudinary block that used to sit here is gone too: nothing in the app has
# ever imported Cloudinary, and it told the next developer to put an API
# *secret* behind NEXT_PUBLIC_ — which would have published it the same way.
