# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=kalamitra
# Timeouts (ms). There were none before; a Mongo blip hung requests forever.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=20000
MONGO_MAX_POOL_SIZE=50

# Firebase Configuration
# Path to the service-account JSON. Mount it at runtime - it must NOT be baked
# into the Docker image (see .dockerignore).
FIREBASE_SERVICE_ACCOUNT_PATH="firebaseservicekey.json"
# NOTE: the previous version of this file committed a real Firebase web API key
# and project id. Those are public-by-design client values, but an example file
# should still carry placeholders.
FIREBASE_PROJECT_ID=your_firebase_project_id

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Never enable reload in production (it used to be hardcoded True in main.py).
RELOAD=false

# Security
# Comma-separated list of exact origins. Used for BOTH the CORS allowlist and
# the Stripe success/cancel redirect URLs (the first entry wins for redirects).
# A "*" wildcard is invalid here: CORS forbids it alongside credentials.
ALLOWED_ORIGINS=http://localhost:3000

# Public base URL of THIS backend; used to build product image URLs.
API_BASE_URL=http://localhost:8000

# AI Configuration
# SERVER-SIDE ONLY. There is deliberately no NEXT_PUBLIC_ variant: the frontend
# used to hold NEXT_PUBLIC_GEMINI_API_KEY, which Next.js inlines into the public
# JS bundle, so the key shipped in plaintext to every visitor on every route.
# The browser now calls POST /api/chat and POST /api/search/translate instead
# (routes/ai.py) and never sees a key.
# If this variable is unset, both endpoints degrade: /api/chat returns 503 and
# /api/search/translate falls back to local keyword extraction.
# ROTATE the previously-exposed key - it is already public.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# Rate limits for the Gemini proxy. These endpoints cost money per call and are
# reachable without authentication, so they are capped three ways: per
# authenticated user, per IP for anonymous callers, and a process-wide ceiling
# that no identity rotation can escape. Counts are per window, per process.
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_CHAT_RATE_LIMIT=10
AI_TRANSLATE_RATE_LIMIT=20
AI_GLOBAL_RATE_LIMIT=120
AI_CHAT_TIMEOUT_SECONDS=30
AI_TRANSLATE_TIMEOUT_SECONDS=15

# Whether to read the caller's IP from X-Forwarded-For. True is correct behind
# Render/Vercel/any reverse proxy; set false for a directly-exposed process,
# where the header is unverified client input.
TRUST_PROXY_HEADERS=true

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# NEW - REQUIRED for POST /api/stripe/webhook. Without it that endpoint returns
# 500 and no order will ever move from "pending" to "paid".
# Local:  stripe listen --forward-to localhost:8000/api/stripe/webhook
# Deployed: copy the signing secret from the Stripe dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_TIMEOUT_SECONDS=15
